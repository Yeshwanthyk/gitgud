{
	"name": "gitgud-skills",
	"version": "0.0.14",
	"description": "CLI for managing AI agent skills",
	"keywords": ["cli", "ai", "agents", "skills", "claude", "claude-code"],
	"author": "yesh",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/Yeshwanthyk/gitgud.git"
	},
	"type": "module",
	"bin": {
		"gitgud": "./dist/cli.js"
	},
	"files": ["dist/cli.js"],
	"scripts": {
		"dev": "bun --watch src/cli.ts",
		"build": "bun build src/cli.ts --outdir dist --target bun --external giget --external yaml",
		"build:binary": "bun build src/cli.ts --compile --outfile dist/gitgud",
		"prepublishOnly": "bun run build",
		"lint": "oxlint -c .oxlintrc.json src/",
		"lint:types": "eslint src/",
		"lint:all": "bun run lint && bun run lint:types",
		"lint:fix": "oxlint -c .oxlintrc.json --fix src/ && eslint --fix src/",
		"format": "oxfmt src/ test/",
		"format:check": "oxfmt --check src/ test/",
		"knip": "knip",
		"typecheck": "tsc --noEmit",
		"check": "bun run lint:all && bun run format:check && bun run typecheck && bun run knip",
		"test": "bun test",
		"build:all": "bun run build:darwin-arm64 && bun run build:darwin-x64 && bun run build:linux-x64 && bun run build:linux-arm64",
		"build:darwin-arm64": "bun build src/cli.ts --compile --target=bun-darwin-arm64 --outfile dist/gitgud-darwin-arm64",
		"build:darwin-x64": "bun build src/cli.ts --compile --target=bun-darwin-x64 --outfile dist/gitgud-darwin-x64",
		"build:linux-x64": "bun build src/cli.ts --compile --target=bun-linux-x64 --outfile dist/gitgud-linux-x64",
		"build:linux-arm64": "bun build src/cli.ts --compile --target=bun-linux-arm64 --outfile dist/gitgud-linux-arm64",
		"prepare": "lefthook install"
	},
	"dependencies": {
		"yaml": "^2.0.0"
	},
	"devDependencies": {
		"@types/bun": "^1.3.0",
		"@typescript-eslint/eslint-plugin": "^8.59.1",
		"@typescript-eslint/parser": "^8.59.1",
		"eslint": "^10.3.0",
		"eslint-plugin-unused-imports": "^4.4.1",
		"knip": "^6.10.0",
		"lefthook": "^2.0.11",
		"oxfmt": "^0.47.0",
		"oxlint": "^1.62.0",
		"typescript": "^6.0.3"
	}
}
